---
// Foto de fondo del Hero. Vacío = negro con brillo rojo suave.
// Cuando llegue una foto buena (1920 px de ancho, unos 150 KB): "/images/portada.webp"
const fondo = "";

// Horario en minutos desde medianoche: 7:30 = 450, 18:00 = 1080
const apertura = 7 * 60 + 30;
const cierre = 18 * 60;

const estilo = fondo
	? `background: linear-gradient(rgba(0,0,0,0.75), rgba(0,0,0,0.75)), url('${fondo}') center / cover;`
	: "background: radial-gradient(ellipse 80% 90% at 50% 0%, rgba(225,11,21,0.32), rgba(0,0,0,0) 70%), #000000;";

// "Abierto ahora" calculado con la hora de Ecuador
const abiertoAhora = String.raw`{
	listo: false,
	abierto: false,
	init() {
		const hora = new Intl.DateTimeFormat('en-GB', {
			timeZone: 'America/Guayaquil',
			hour: '2-digit',
			minute: '2-digit',
			hourCycle: 'h23'
		}).format(new Date());
		const [h, m] = hora.split(':').map(Number);
		const minutos = h * 60 + m;
		this.abierto = minutos >= ${apertura} && minutos < ${cierre};
		this.listo = true;
	}
}`;
---

<section class="border-b border-marca text-center px-6 py-20 md:py-28" style={estilo}>
	<h1 class="mb-6">
		<span class="block text-marca-texto text-sm md:text-base font-semibold uppercase tracking-[0.38em] pl-[0.38em]">
			Sabores de
		</span>
		<span class="block font-script text-texto text-6xl md:text-8xl leading-none mt-1">
			Imbabura
		</span>
	</h1>

	<p class="font-display font-bold text-texto text-xl md:text-3xl leading-snug max-w-2xl mx-auto mb-5">
		Desayunos, almuerzos y parrilladas de la sierra
	</p>

	<div class="mx-auto mb-6 h-px w-16 bg-marca"></div>

	<p
		x-data={abiertoAhora}
		x-show="listo"
		style="display: none;"
		class="inline-flex items-center gap-2 rounded-full border border-borde bg-superficie/90 px-4 py-2 text-sm text-texto-suave mb-6"
	>
		<span class="h-2.5 w-2.5 rounded-full" :class="abierto ? 'bg-green-500' : 'bg-red-500'"></span>
		<span x-text="abierto ? 'Abierto ahora · cierra a las 18:00' : 'Cerrado ahora · abrimos a las 7:30'"></span>
	</p>

	<p class="text-texto-suave max-w-xl mx-auto mb-8">
		Platos tradicionales de Imbabura, de lunes a domingo y feriados.
	</p>

	<div class="flex flex-wrap items-center justify-center gap-3">
		<a href="#menu" class="inline-block bg-marca text-texto font-medium px-8 py-3 rounded-full uppercase tracking-wide text-sm hover:bg-marca-oscuro transition">
			Ver menú
		</a>
		<a href="tel:+593961999300" class="inline-block border border-texto-tenue text-texto font-medium px-8 py-3 rounded-full uppercase tracking-wide text-sm hover:border-marca hover:text-marca-texto transition">
			Llamar
		</a>
	</div>
</section>