---
const mapsUrl = "https://maps.app.goo.gl/hfxUxnuoh812vGax6";
const lat = 0.1495276;
const lng = -78.186543;
const embedUrl = `https://www.google.com/maps?q=${lat},${lng}&z=17&output=embed`;
---

<footer id="contacto" class="bg-fondo text-center py-12 px-6 border-t border-marca scroll-mt-4">
	<h3 class="font-display font-bold text-texto text-2xl mb-1">Casona Betsabé</h3>
	<p class="font-script text-marca-texto text-3xl mb-6">Sabores de Imbabura</p>

	<div class="text-texto-suave text-sm space-y-2 mb-6">
		<p>
			📍
			<a href={mapsUrl} target="_blank" rel="noopener noreferrer" class="underline hover:text-marca-texto">
				Cómo llegar (Google Maps)
			</a>
		</p>
		<p>
			📞
			<a href="tel:+593961999300" class="underline hover:text-marca-texto">096 199 9300</a>
			<span class="mx-2">·</span>
			<a href="tel:+593991239080" class="underline hover:text-marca-texto">099 123 9080</a>
		</p>
		<p>🕒 Lunes a domingo y feriados · 7:30 a 18:00</p>
	</div>

	<div class="max-w-3xl mx-auto mb-8">
		<iframe
			src={embedUrl}
			title="Ubicación de Casona Betsabé en Google Maps"
			loading="lazy"
			referrerpolicy="no-referrer-when-downgrade"
			class="w-full h-64 rounded border border-borde"
		></iframe>
	</div>

	<p class="text-texto-tenue text-xs">
		© 2026 Casona Betsabé Restaurante. Todos los derechos reservados.
	</p>
</footer>