---
// Fuentes de la marca (instaladas con Fontsource)
import "@fontsource/poppins/latin-400.css";
import "@fontsource/poppins/latin-500.css";
import "@fontsource/poppins/latin-600.css";
import "@fontsource/poppins/latin-700.css";
import "@fontsource/playfair-display/latin-700.css";
import "@fontsource/kaushan-script/latin-400.css";
---

<header class="bg-fondo border-b border-marca px-6 py-3">
	<div class="max-w-5xl mx-auto flex items-center justify-between">
		<a href="#" aria-label="Casona Betsabé, ir al inicio">
			<img
				src="/images/logo-casona-betsabe.png"
				alt="Casona Betsabé Restaurante"
				width="620"
				height="326"
				class="h-14 w-auto"
			/>
		</a>
		<a
			href="#contacto"
			class="border border-borde text-texto text-xs md:text-sm font-medium uppercase tracking-wide px-4 py-2 rounded-full hover:border-marca hover:text-marca-texto transition"
		>
			Contacto
		</a>
	</div>
</header>