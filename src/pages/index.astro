---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Footer from "../components/Footer.astro";
import { getCollection } from "astro:content";

const platos = await getCollection("menu");
const categorias = [...new Set(platos.map((p) => p.data.categoria))];

const imagenesCategoria: Record<string, string> = {
	"Desayunos": "/images/foto-desayuno.jpg",
	"Platos Fuertes": "/images/foto-parrillada.jpg",
};
---

<html lang="es">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Casona Betsabé Restaurante</title>
		<meta name="description" content="Casona Betsabé Restaurante - Sabores de Imbabura" />
	</head>
	<body class="bg-black text-white">
		<Header />
		<Hero />

		<section id="menu" class="max-w-3xl mx-auto py-16 px-6">
			<div x-data="{ activa: 'Todo' }">

				<div class="flex gap-2 overflow-x-auto pb-6 mb-6">
					<button
						@click="activa = 'Todo'"
						:class="activa === 'Todo' ? 'bg-red-600' : 'bg-gray-800'"
						class="px-4 py-2 rounded-full whitespace-nowrap text-sm font-bold"
					>
						Todo
					</button>
					{categorias.map((categoria) => (
						<button
							@click={`activa = '${categoria}'`}
							:class={`activa === '${categoria}' ? 'bg-red-600' : 'bg-gray-800'`}
							class="px-4 py-2 rounded-full whitespace-nowrap text-sm font-bold"
						>
							{categoria}
						</button>
					))}
				</div>

				{categorias.map((categoria) => (
					<div class="mb-12" x-transition x-show={`activa === 'Todo' || activa === '${categoria}'`}>
						{imagenesCategoria[categoria] && (
							<img
								src={imagenesCategoria[categoria]}
								alt={categoria}
								class="w-full h-48 object-cover rounded mb-6"
							/>
						)}
						<h2 class="text-red-600 text-2xl font-serif italic mb-6 border-b border-red-600 pb-2">
							{categoria}
						</h2>
						<div class="space-y-4">
							{platos
								.filter((p) => p.data.categoria === categoria)
								.map((plato) => (
									<div class="flex justify-between gap-4 border-b border-gray-800 pb-3">
										<div>
											<h3 class="text-lg font-bold">{plato.data.nombre}</h3>
											{plato.data.descripcion && (
												<p class="text-gray-400 text-sm">{plato.data.descripcion}</p>
											)}
										</div>
										<span class="text-red-500 font-bold whitespace-nowrap">${plato.data.precio.toFixed(2)}</span>
									</div>
								))}
						</div>
					</div>
				))}

			</div>
		</section>

		<Footer />
	</body>
</html>