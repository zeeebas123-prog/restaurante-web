---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Footer from "../components/Footer.astro";
import WhatsAppButton from "../components/WhatsAppButton.astro";
import { getCollection } from "astro:content";

const platos = await getCollection("menu");

// Orden de las categorías (las que no estén aquí se agregan al final)
const ordenCategorias = [
	"Desayunos",
	"Almuerzos",
	"Platos Fuertes",
	"Para Niños",
	"Postres",
	"Bebidas",
	"Licores",
];
const existentes = [...new Set(platos.map((p) => p.data.categoria))];
const categorias = [
	...ordenCategorias.filter((c) => existentes.includes(c)),
	...existentes.filter((c) => !ordenCategorias.includes(c)),
];

// Platos de una categoría, del más económico al más caro
const platosDe = (categoria: string) =>
	platos
		.filter((p) => p.data.categoria === categoria)
		.sort((a, b) => a.data.precio - b.data.precio);

// ---------- SEO ----------
// Cuando tengas dominio propio, cambia solo esta línea
const sitio = "https://restaurante-web-eight.vercel.app";
const titulo = "Casona Betsabé Restaurante | Menú y sabores de Imbabura";
const descripcion =
	"Conoce el menú de Casona Betsabé: desayunos, almuerzos, asados de borrego, trucha, fritada y postres tradicionales de Imbabura.";
const imagenSocial = `${sitio}/images/foto-parrillada.jpg`;

const datosEstructurados = {
	"@context": "https://schema.org",
	"@type": "Restaurant",
	name: "Casona Betsabé Restaurante",
	url: sitio,
	image: imagenSocial,
	description: descripcion,
	telephone: "+593961999300",
	servesCuisine: "Ecuatoriana",
	hasMenu: `${sitio}/#menu`,
	hasMap: "https://maps.app.goo.gl/hfxUxnuoh812vGax6",
	geo: {
		"@type": "GeoCoordinates",
		latitude: 0.1495276,
		longitude: -78.186543,
	},
	openingHoursSpecification: [
		{
			"@type": "OpeningHoursSpecification",
			dayOfWeek: [
				"Monday",
				"Tuesday",
				"Wednesday",
				"Thursday",
				"Friday",
				"Saturday",
				"Sunday",
			],
			opens: "07:30",
			closes: "18:00",
		},
	],
};
// -------------------------

// Quita tildes y pasa a minúsculas para que "montanes" encuentre "Montañés"
const normalizar = (t: string) =>
	t.normalize("NFD").replace(/[\u0300-\u036f]/g, "").toLowerCase();

// Texto buscable de cada categoría (nombres + descripciones de sus platos)
const mapa: Record<string, string> = {};
for (const categoria of categorias) {
	mapa[categoria] = platosDe(categoria)
		.map((p) => normalizar(`${p.data.nombre} ${p.data.descripcion ?? ""}`))
		.join("|");
}

// Estado y funciones de Alpine
const xdata = String.raw`{
	activa: 'Todo',
	busqueda: '',
	mapa: ${JSON.stringify(mapa)},
	q() {
		return this.busqueda.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase().trim();
	},
	hay() {
		return Object.entries(this.mapa).some(
			([c, t]) => (this.activa === 'Todo' || this.activa === c) && t.includes(this.q())
		);
	}
}`;
---

<html lang="es">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<meta name="theme-color" content="#000000" />

		<!-- DEMO: oculta la página de Google. BORRAR esta línea cuando el cliente apruebe y se publique -->
		<meta name="robots" content="noindex, nofollow" />

		<title>{titulo}</title>
		<meta name="description" content={descripcion} />
		<link rel="canonical" href={sitio + "/"} />

		<!-- Vista previa al compartir (WhatsApp, Facebook, etc.) -->
		<meta property="og:type" content="restaurant.restaurant" />
		<meta property="og:site_name" content="Casona Betsabé" />
		<meta property="og:locale" content="es_EC" />
		<meta property="og:title" content={titulo} />
		<meta property="og:description" content={descripcion} />
		<meta property="og:url" content={sitio + "/"} />
		<meta property="og:image" content={imagenSocial} />
		<meta property="og:image:alt" content="Parrillada de la Casona Betsabé" />

		<!-- Vista previa en X/Twitter -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={titulo} />
		<meta name="twitter:description" content={descripcion} />
		<meta name="twitter:image" content={imagenSocial} />

		<!-- Datos estructurados para Google -->
		<script type="application/ld+json" set:html={JSON.stringify(datosEstructurados)} />
	</head>
	<body class="bg-black text-white">
		<Header />
		<Hero />

		<section id="menu" class="max-w-3xl mx-auto py-16 px-6">
			<div x-data={xdata}>

				<input
					type="search"
					x-model="busqueda"
					placeholder="Buscar plato (ej. trucha, borrego, jugo)..."
					aria-label="Buscar en el menú"
					autocomplete="off"
					class="w-full mb-4 px-5 py-3 rounded-full bg-gray-900 border border-gray-700 text-white placeholder-gray-500 focus:outline-none focus:border-red-600"
				/>

				<div class="flex gap-2 overflow-x-auto pb-6 mb-6">
					<button
						@click="activa = 'Todo'"
						:class="activa === 'Todo' ? 'bg-red-600' : 'bg-gray-800'"
						class="px-4 py-2 rounded-full whitespace-nowrap text-sm font-bold"
					>
						Todo
					</button>
					{categorias.map((categoria) => (
						<button
							@click={`activa = '${categoria}'`}
							:class={`activa === '${categoria}' ? 'bg-red-600' : 'bg-gray-800'`}
							class="px-4 py-2 rounded-full whitespace-nowrap text-sm font-bold"
						>
							{categoria}
						</button>
					))}
				</div>

				<p
					x-show="!hay()"
					style="display: none;"
					class="text-center text-gray-400 py-12"
				>
					No encontramos platos con "<span x-text="busqueda"></span>". Prueba con otra palabra.
				</p>

				{categorias.map((categoria) => (
					<div
						class="mb-12"
						x-transition
						x-show={`(activa === 'Todo' || activa === '${categoria}') && mapa['${categoria}'].includes(q())`}
					>
						<h2 class="text-red-600 text-2xl font-serif italic mb-6 border-b border-red-600 pb-2">
							{categoria}
						</h2>
						<div class="space-y-4">
							{platosDe(categoria).map((plato) => (
								<div
									class="flex justify-between gap-4 border-b border-gray-800 pb-3"
									data-texto={normalizar(`${plato.data.nombre} ${plato.data.descripcion ?? ""}`)}
									x-show="$el.dataset.texto.includes(q())"
								>
									<div>
										<h3 class="text-lg font-bold">{plato.data.nombre}</h3>
										{plato.data.descripcion && (
											<p class="text-gray-400 text-sm">{plato.data.descripcion}</p>
										)}
									</div>
									<span class="text-red-500 font-bold whitespace-nowrap">${plato.data.precio.toFixed(2)}</span>
								</div>
							))}
						</div>
					</div>
				))}

			</div>
		</section>

		<Footer />
		<WhatsAppButton />
	</body>
</html>
