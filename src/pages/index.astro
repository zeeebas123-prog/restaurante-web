---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Footer from "../components/Footer.astro";
import WhatsAppButton from "../components/WhatsAppButton.astro";
import { getCollection } from "astro:content";

const platos = await getCollection("menu");
const hayFotos = platos.some((p) => p.data.imagen);

// Orden de las categorías (las que no estén aquí se agregan al final)
const ordenCategorias = [
	"Desayunos",
	"Almuerzos",
	"Platos Fuertes",
	"Para Niños",
	"Postres",
	"Bebidas",
	"Licores",
];
const existentes = [...new Set(platos.map((p) => p.data.categoria))];
const categorias = [
	...ordenCategorias.filter((c) => existentes.includes(c)),
	...existentes.filter((c) => !ordenCategorias.includes(c)),
];

// Los 4 accesos de la barra fija (cada uno agrupa categorías)
const gruposBase = [
	{ id: "desayunos", nombre: "Desayunos", categorias: ["Desayunos"] },
	{ id: "platos", nombre: "Platos", categorias: ["Almuerzos", "Platos Fuertes", "Para Niños"] },
	{ id: "postres", nombre: "Postres", categorias: ["Postres"] },
	{ id: "bebidas", nombre: "Bebidas", categorias: ["Bebidas", "Licores"] },
];
const asignadas = gruposBase.flatMap((g) => g.categorias);
const sueltas = categorias.filter((c) => !asignadas.includes(c));
if (sueltas.length) gruposBase.push({ id: "otros", nombre: "Otros", categorias: sueltas });

const grupos = gruposBase
	.map((g) => ({ ...g, categorias: g.categorias.filter((c) => categorias.includes(c)) }))
	.filter((g) => g.categorias.length > 0);

// Platos de una categoría, del más económico al más caro
const platosDe = (categoria: string) =>
	platos
		.filter((p) => p.data.categoria === categoria)
		.sort((a, b) => a.data.precio - b.data.precio);

// ---------- SEO ----------
// Cuando tengas dominio propio, cambia solo esta línea
const sitio = "https://restaurante-web-eight.vercel.app";
const titulo = "Casona Betsabé Restaurante | Menú y sabores de Imbabura";
const descripcion =
	"Conoce el menú de Casona Betsabé: desayunos, almuerzos, asados de borrego, trucha, fritada y postres tradicionales de Imbabura.";
const imagenSocial = `${sitio}/images/foto-parrillada.jpg`;

const datosEstructurados = {
	"@context": "https://schema.org",
	"@type": "Restaurant",
	name: "Casona Betsabé Restaurante",
	url: sitio,
	image: imagenSocial,
	description: descripcion,
	telephone: "+593961999300",
	servesCuisine: "Ecuatoriana",
	hasMenu: `${sitio}/#menu`,
	hasMap: "https://maps.app.goo.gl/hfxUxnuoh812vGax6",
	geo: {
		"@type": "GeoCoordinates",
		latitude: 0.1495276,
		longitude: -78.186543,
	},
	openingHoursSpecification: [
		{
			"@type": "OpeningHoursSpecification",
			dayOfWeek: [
				"Monday",
				"Tuesday",
				"Wednesday",
				"Thursday",
				"Friday",
				"Saturday",
				"Sunday",
			],
			opens: "07:30",
			closes: "18:00",
		},
	],
};
// -------------------------

// Quita tildes y pasa a minúsculas para que "montanes" encuentre "Montañés"
const normalizar = (t: string) =>
	t.normalize("NFD").replace(/[\u0300-\u036f]/g, "").toLowerCase();

// Texto buscable de cada categoría (nombres + descripciones de sus platos)
const mapa: Record<string, string> = {};
for (const categoria of categorias) {
	mapa[categoria] = platosDe(categoria)
		.map((p) => normalizar(`${p.data.nombre} ${p.data.descripcion ?? ""}`))
		.join("|");
}

// Estado de Alpine: búsqueda + grupo visible mientras se desplaza la página
const xdata = String.raw`{
	busqueda: '',
	grupo: '',
	mapa: ${JSON.stringify(mapa)},
	q() {
		return this.busqueda.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase().trim();
	},
	hay() {
		return Object.values(this.mapa).some((t) => t.includes(this.q()));
	},
	init() {
		const obs = new IntersectionObserver(
			(entradas) => {
				entradas.forEach((e) => {
					if (e.isIntersecting) this.grupo = e.target.dataset.grupo;
				});
			},
			{ rootMargin: '-25% 0px -65% 0px' }
		);
		document.querySelectorAll('[data-grupo]').forEach((el) => obs.observe(el));
	}
}`;
---

<html lang="es">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<meta name="theme-color" content="#000000" />

		<!-- DEMO: oculta la página de Google. BORRAR esta línea cuando el cliente apruebe y se publique -->
		<meta name="robots" content="noindex, nofollow" />

		<title>{titulo}</title>
		<meta name="description" content={descripcion} />
		<link rel="canonical" href={sitio + "/"} />

		<!-- Vista previa al compartir (WhatsApp, Facebook, etc.) -->
		<meta property="og:type" content="restaurant.restaurant" />
		<meta property="og:site_name" content="Casona Betsabé" />
		<meta property="og:locale" content="es_EC" />
		<meta property="og:title" content={titulo} />
		<meta property="og:description" content={descripcion} />
		<meta property="og:url" content={sitio + "/"} />
		<meta property="og:image" content={imagenSocial} />
		<meta property="og:image:alt" content="Parrillada de la Casona Betsabé" />

		<!-- Vista previa en X/Twitter -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={titulo} />
		<meta name="twitter:description" content={descripcion} />
		<meta name="twitter:image" content={imagenSocial} />

		<!-- Datos estructurados para Google -->
		<script type="application/ld+json" set:html={JSON.stringify(datosEstructurados)} />
	</head>
	<body class="bg-fondo text-texto">
		<Header />
		<Hero />

		<section id="menu" class="max-w-3xl mx-auto pt-12 pb-16 px-6">
			<div x-data={xdata}>

				<input
					type="search"
					x-model="busqueda"
					placeholder="Buscar plato (ej. trucha, borrego, jugo)..."
					aria-label="Buscar en el menú"
					autocomplete="off"
					class="w-full h-12 mb-4 px-5 rounded-full bg-superficie border border-borde text-texto text-base placeholder-texto-tenue focus:outline-none focus:border-marca"
				/>

				<!-- Barra fija: queda pegada arriba mientras se recorre el menú -->
				<nav
					aria-label="Secciones del menú"
					class="sticky top-0 z-40 -mx-6 px-6 py-3 mb-8 bg-fondo/95 backdrop-blur border-b border-borde"
				>
					<div class="grid gap-2" style={`grid-template-columns: repeat(${grupos.length}, minmax(0, 1fr));`}>
						{grupos.map((g) => (
							<a
								href={`#${g.id}`}
								:class={`grupo === '${g.id}' ? 'bg-marca text-texto border-marca' : 'bg-superficie text-texto-suave border-borde'`}
								class="min-h-11 flex items-center justify-center rounded-full border text-xs sm:text-sm font-bold px-1 transition-colors"
							>
								{g.nombre}
							</a>
						))}
					</div>
				</nav>

				<p
					x-show="!hay()"
					style="display: none;"
					class="text-center text-texto-tenue py-12"
				>
					No encontramos platos con "<span x-text="busqueda"></span>". Prueba con otra palabra.
				</p>

				{grupos.map((g) => (
					<div
						id={g.id}
						data-grupo={g.id}
						class="scroll-mt-24"
						x-show={`[${g.categorias.map((c) => `'${c}'`).join(",")}].some((c) => mapa[c].includes(q()))`}
					>
						{g.categorias.map((categoria) => (
							<div class="mb-12" x-show={`mapa['${categoria}'].includes(q())`}>
								<h2 class="text-marca-texto text-2xl font-serif italic mb-5 border-b border-marca pb-2">
									{categoria}
								</h2>
								<div class="space-y-3">
									{platosDe(categoria).map((plato) => (
										<article
											class="flex items-start gap-4 rounded-xl bg-superficie border border-borde p-4"
											data-texto={normalizar(`${plato.data.nombre} ${plato.data.descripcion ?? ""}`)}
											x-show="$el.dataset.texto.includes(q())"
										>
											{plato.data.imagen && (
												<img
													src={`/images/platos/${plato.data.imagen}`}
													alt={plato.data.nombre}
													width="96"
													height="96"
													loading="lazy"
													onerror="this.style.display='none'"
													class="h-20 w-20 sm:h-24 sm:w-24 shrink-0 rounded-lg object-cover"
												/>
											)}
											<div class="min-w-0 flex-1">
												<div class="flex items-start justify-between gap-3">
													<h3 class="text-base sm:text-lg font-bold leading-snug">{plato.data.nombre}</h3>
													<span class="shrink-0 rounded-md bg-marca px-2.5 py-1 text-sm font-bold italic text-texto whitespace-nowrap">
														${plato.data.precio.toFixed(2)}
													</span>
												</div>
												{plato.data.etiqueta && (
													<span class="inline-block mt-1 text-xs uppercase tracking-wide text-marca-texto border border-marca/60 rounded-full px-2 py-0.5">
														{plato.data.etiqueta}
													</span>
												)}
												{plato.data.descripcion && (
													<p class="mt-2 text-texto-tenue text-sm leading-relaxed">{plato.data.descripcion}</p>
												)}
											</div>
										</article>
									))}
								</div>
							</div>
						))}
					</div>
				))}

				{hayFotos && (
					<p class="text-center text-texto-tenue text-xs">Imágenes referenciales.</p>
				)}

			</div>
		</section>

		<Footer />
		<WhatsAppButton />
	</body>
</html>